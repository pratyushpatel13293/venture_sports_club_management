# Copy this file to .env (same folder as pom.xml) and fill in real values.
# .env is git-ignored: never commit secrets.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/venture_sports?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# --- JWT (at least 32 random characters each, and different from each other) ---
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1234567890
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-0987654321

# --- Frontend origins allowed by CORS (comma separated, wildcards allowed) ---
CORS_ALLOWED_ORIGINS=http://localhost:*,https://venture-flax.vercel.app

# --- E-mail for forgot-password OTPs (optional; without it the OTP is printed in the console) ---
# Gmail: turn on 2-step verification, then create an "App password".
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Gemini AI commentary (optional; without it template text is used) ---
GEMINI_API_KEY=
